# Normalizacao de finais de linha.
# O repo usa CRLF para arquivos de texto (padrao Windows / convencao do projeto).
# Isso elimina o ruido de "modificado" causado por conversao de line-ending.

* text=auto eol=crlf

# Codigo e texto (CRLF)
*.cs      text eol=crlf
*.ps1     text eol=crlf
*.md      text eol=crlf
*.json    text eol=crlf
*.txt     text eol=crlf
*.manifest text eol=crlf
.gitattributes text eol=crlf
.gitignore     text eol=crlf

# Binarios (nunca converter)
*.png     binary
*.exe     binary
*.dll     binary
*.zip     binary
*.ico     binary
